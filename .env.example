# Edibel ortam değişkenleri.
# Bu dosyayı .env olarak kopyalayıp gerçek değerleri girin.
# Gerçek anahtarlar yalnızca .env içinde bulunur ve depoya asla yazılmaz.

# PostgreSQL bağlantısı.
# Geliştirme: docker-compose.yml içindeki veritabanı (127.0.0.1:5433).
# Üretim: sunucudaki kapsayıcı; değerler Faz 9'da belirlenir.
DATABASE_URL=postgres://edibel:edibel_dev@127.0.0.1:5433/edibel

# Görme yeteneği olan dil modeli sağlayıcısı (Katman 2: okuma ve çeviri).
# Desteklenen değerler Faz 6'da src/lib/ai altında tanımlanır; varsayılan
# sağlayıcı Anthropic'tir.
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-opus-5

# Harici gömme (embedding) arayüzü (Katman 4'ün son yöntemi; seyrek çağrılır).
# Model 768 boyutlu vektör üretmelidir; veritabanı şeması vector(768) kullanır.
EMBEDDING_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001

# Uygulamanın herkese açık adresi.
# Geliştirme: http://localhost:3200  Üretim: https://edibel.talhaonur.com
NEXT_PUBLIC_APP_URL=http://localhost:3200

# /admin yönetim sayfasını koruyan gizli anahtar (Faz 8'de kullanılır).
ADMIN_TOKEN=
