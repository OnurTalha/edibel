# Edibel üretim ortam değişkenleri.
# Bu dosyayı sunucuda deploy/.env olarak kopyalayın ve gerçek değerleri girin.
# deploy/.env dosyası depoya girmez (bkz. .gitignore) ve izinleri 600 olmalıdır.

# --- Veritabanı kapsayıcısı ---
# Bu üç değer yalnızca db kapsayıcısına verilir.
POSTGRES_USER=edibel
POSTGRES_PASSWORD=buraya-guclu-bir-parola-yazin
POSTGRES_DB=edibel

# --- Uygulama kapsayıcısı ---
# Uygulama veritabanına compose ağı üzerinden "db" adıyla ulaşır.
# Kullanıcı, parola ve veritabanı adı yukarıdaki değerlerle aynı olmalıdır.
DATABASE_URL=postgres://edibel:buraya-guclu-bir-parola-yazin@db:5432/edibel

# Görme modeli sağlayıcısı (Katman 2: okuma ve çeviri)
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-opus-5

# Harici gömme arayüzü (Katman 4'ün son yöntemi; çalışma anında seyrek çağrılır)
EMBEDDING_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001

# Uygulamanın herkese açık adresi
NEXT_PUBLIC_APP_URL=https://edibel.talhaonur.com

# /admin yönetim sayfasını koruyan gizli anahtar.
# Örnek üretim: openssl rand -hex 32
ADMIN_TOKEN=
